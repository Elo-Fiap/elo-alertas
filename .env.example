# Copie para .env e ajuste. O .env não vai para o git.
DATABASE_URL="postgresql://elo:elo_local@localhost:54340/elo_alertas?schema=public"
PORTA=3040
# Chave do dispositivo da régua de exemplo (o ESP32 manda no header X-Chave-Dispositivo).
# Troque por um valor seu; o seed guarda só o hash sha256.
CHAVE_REGUA_EXEMPLO="troque-esta-chave-de-exemplo"
INMET_URL="https://apiprevmet3.inmet.gov.br/avisos/ativos"
# Minutos até a última sincronização com o INMET ser considerada vencida.
AVISOS_VALIDADE_MIN=5
