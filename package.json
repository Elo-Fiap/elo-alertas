{
  "name": "elo-alertas",
  "version": "1.0.0",
  "description": "Serviço de SOA do Elo: leituras da régua de nível e avisos do INMET por município.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/servidor.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/servidor.js",
    "db:subir": "docker compose up -d --wait",
    "db:parar": "docker compose stop",
    "db:migrar": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test": "vitest run --maxWorkers=2 test/unidade",
    "test:integracao": "vitest run --config vitest.integracao.config.ts",
    "lint": "tsc --noEmit",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@prisma/client": "^6.19.3",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.8",
    "typebox": "^1.4.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
